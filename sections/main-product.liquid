{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign form_id = 'product-form-' | append: section.id
-%}
<section class="product" data-product data-section="{{ section.id }}" data-url="{{ product.url }}">
  <div class="product__media">
    {%- if product.media.size > 0 -%}
      {%- for media in product.media -%}
        {%- liquid
          assign loading = 'lazy'
          if forloop.first
            assign loading = 'eager'
          endif
        -%}
        <figure class="product__figure" data-media-id="{{ media.id }}">
          {%- case media.media_type -%}
            {%- when 'image' -%}
              {{
                media
                | image_url: width: 1800
                | image_tag:
                  loading: loading,
                  widths: '600, 900, 1200, 1500, 1800',
                  sizes: '(min-width: 990px) 58vw, 100vw',
                  alt: media.alt
              }}
            {%- when 'video' -%}
              {{ media | video_tag: controls: true, image_size: '1200x' }}
            {%- when 'external_video' -%}
              {{ media | external_video_tag }}
            {%- else -%}
              {{ media | media_tag }}
          {%- endcase -%}
        </figure>
      {%- endfor -%}
    {%- else -%}
      <figure class="product__figure">{% render 'jersey-placeholder', id: section.id, side: 'front' %}</figure>
      <figure class="product__figure">{% render 'jersey-placeholder', id: section.id, side: 'back' %}</figure>
    {%- endif -%}
  </div>

  <div class="product__info">
    <div class="product__sticky">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when '@app' -%}
            {% render block %}

          {%- when 'title' -%}
            <h1 class="product__title" {{ block.shopify_attributes }}>{{ product.title | escape }}</h1>

          {%- when 'price' -%}
            <div class="product__price" {{ block.shopify_attributes }}>
              <div data-price>{% render 'price', variant: current_variant %}</div>
              <p class="product__tax">
                {%- if cart.taxes_included -%}
                  {{ 'products.tax_included' | t }}
                {%- endif %}
                {{ 'products.shipping_at_checkout' | t -}}
              </p>
            </div>

          {%- when 'variant_picker' -%}
            {%- unless product.has_only_default_variant -%}
              <div class="variants" data-variant-picker {{ block.shopify_attributes }}>
                {%- for option in product.options_with_values -%}
                  <fieldset class="variants__group">
                    <legend class="variants__legend">
                      {{ option.name | escape }}<span class="variants__current" data-option-current>{{ option.selected_value | escape }}</span>
                    </legend>
                    <div class="variants__values">
                      {%- for value in option.values -%}
                        {%- assign input_id = section.id | append: '-' | append: option.position | append: '-' | append: forloop.index -%}
                        <input
                          type="radio"
                          class="visually-hidden"
                          id="{{ input_id }}"
                          name="{{ section.id }}-{{ option.name | handle }}"
                          value="{{ value | escape }}"
                          {% if value.selected %}checked{% endif %}
                        >
                        <label class="pill{% unless value.available %} pill--na{% endunless %}" for="{{ input_id }}">
                          {{- value | escape -}}
                        </label>
                      {%- endfor -%}
                    </div>
                  </fieldset>
                {%- endfor -%}
                <script type="application/json" data-variants>
                  [
                    {%- for variant in product.variants -%}
                      {
                        "id": {{ variant.id }},
                        "options": {{ variant.options | json }},
                        "available": {{ variant.available | json }},
                        "price": {% capture price_html %}{% render 'price', variant: variant %}{% endcapture %}{{ price_html | strip_newlines | json }},
                        "media": {{ variant.featured_media.id | json }}
                      }{% unless forloop.last %},{% endunless %}
                    {%- endfor -%}
                  ]
                </script>
              </div>
            {%- endunless -%}

          {%- when 'buy_buttons' -%}
            <div class="product__buy" {{ block.shopify_attributes }}>
              {%- form 'product', product, id: form_id, class: 'product-form', novalidate: 'novalidate' -%}
                <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>
                {%- if block.settings.show_quantity -%}
                  <div class="qty">
                    <label for="qty-{{ section.id }}" class="label label--tight">{{ 'products.quantity' | t }}</label>
                    <input class="input qty__input" type="number" id="qty-{{ section.id }}" name="quantity" value="1" min="1" inputmode="numeric">
                  </div>
                {%- endif -%}
                <button
                  type="submit"
                  name="add"
                  class="btn btn--solid btn--block"
                  data-add
                  data-add-label="{{ 'products.add_to_cart' | t | escape }}"
                  data-sold-out="{{ 'products.sold_out' | t | escape }}"
                  data-unavailable="{{ 'products.unavailable' | t | escape }}"
                  {% unless current_variant.available %}disabled{% endunless %}
                >
                  {%- if current_variant.available -%}
                    {{ 'products.add_to_cart' | t }}
                  {%- else -%}
                    {{ 'products.sold_out' | t }}
                  {%- endif -%}
                </button>
                {%- if block.settings.show_dynamic_checkout -%}
                  {{ form | payment_button }}
                {%- endif -%}
              {%- endform -%}
            </div>

          {%- when 'note' -%}
            {%- if block.settings.text != blank -%}
              <p class="note" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</p>
            {%- endif -%}

          {%- when 'size_guide' -%}
            <div class="product__sizeguide" {{ block.shopify_attributes }}>
              <button type="button" class="link-underline" data-dialog-open="sizeguide-{{ block.id }}">
                {{- 'products.size_guide' | t -}}
              </button>
              <dialog class="dialog" id="sizeguide-{{ block.id }}" aria-labelledby="sizeguide-title-{{ block.id }}">
                <div class="dialog__head">
                  <h2 class="dialog__title" id="sizeguide-title-{{ block.id }}">{{ 'products.size_guide' | t }}</h2>
                  <button type="button" class="icon-btn" data-dialog-close aria-label="{{ 'general.close' | t }}">
                    {%- render 'icon', name: 'close' -%}
                  </button>
                </div>
                <div class="rte dialog__body">
                  {%- if block.settings.page != blank -%}
                    {{ block.settings.page.content }}
                  {%- else -%}
                    {{ block.settings.text }}
                  {%- endif -%}
                </div>
              </dialog>
            </div>

          {%- when 'description' -%}
            {%- if product.description != blank -%}
              <div class="rte product__desc" {{ block.shopify_attributes }}>{{ product.description }}</div>
            {%- endif -%}

          {%- when 'collapsible' -%}
            <details class="accordion" {{ block.shopify_attributes }}>
              <summary>{{ block.settings.heading | escape }}</summary>
              <div class="rte accordion__body">
                {%- if block.settings.page != blank -%}
                  {{ block.settings.page.content }}
                {%- else -%}
                  {{ block.settings.text }}
                {%- endif -%}
              </div>
            </details>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": {{ product.title | json }},
    "url": {{ request.origin | append: product.url | json }},
    {%- if product.featured_media -%}
      "image": {{ product.featured_media | image_url: width: 1200 | prepend: 'https:' | json }},
    {%- endif -%}
    "description": {{ product.description | strip_html | json }},
    "brand": { "@type": "Brand", "name": {{ product.vendor | json }} },
    "offers": [
      {%- for variant in product.variants -%}
        {
          "@type": "Offer",
          {%- if variant.sku != blank -%}
            "sku": {{ variant.sku | json }},
          {%- endif -%}
          "availability": "http://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
          "price": {{ variant.price | divided_by: 100.00 | json }},
          "priceCurrency": {{ cart.currency.iso_code | json }},
          "url": {{ request.origin | append: variant.url | json }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
</script>

{% schema %}
{
  "name": "Product",
  "class": "section-product",
  "blocks": [
    { "type": "@app" },
    { "type": "title", "name": "Title", "limit": 1 },
    { "type": "price", "name": "Price", "limit": 1 },
    { "type": "variant_picker", "name": "Size picker", "limit": 1 },
    {
      "type": "buy_buttons",
      "name": "Buy buttons",
      "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "show_quantity", "label": "Show quantity", "default": false },
        {
          "type": "checkbox",
          "id": "show_dynamic_checkout",
          "label": "Show express checkout buttons",
          "info": "Apple Pay, Google Pay, MobilePay and so on, depending on your payment settings.",
          "default": true
        }
      ]
    },
    {
      "type": "note",
      "name": "Note",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Made to order. Ships from the EU." }
      ]
    },
    {
      "type": "size_guide",
      "name": "Size guide",
      "limit": 1,
      "settings": [
        {
          "type": "page",
          "id": "page",
          "label": "Size guide page",
          "info": "Create a page with your size table under Online Store → Pages."
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text when no page is picked",
          "default": "<p>Regular, athletic fit. If you're between sizes, size up for a looser, vintage look. Full measurements coming with the first drop.</p>"
        }
      ]
    },
    { "type": "description", "name": "Description", "limit": 1 },
    {
      "type": "collapsible",
      "name": "Collapsible row",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shipping and returns" },
        { "type": "page", "id": "page", "label": "Content from a page" },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text when no page is picked",
          "default": "<p>Every piece is made to order and ships from the EU, so there are no customs fees inside the EU. You have 14 days to return an order after you receive it.</p>"
        }
      ]
    }
  ]
}
{% endschema %}
