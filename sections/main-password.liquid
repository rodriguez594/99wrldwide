<section class="hero password">
  <div class="hero__content">
    <img class="hero__mark reveal" src="{{ 'mark.png' | asset_url }}" alt="99" width="959" height="882" fetchpriority="high">
    <h1 class="hero__word reveal">{{ section.settings.heading | escape }}</h1>

    {%- if shop.password_message != blank -%}
      <p class="hero__title reveal">{{ shop.password_message }}</p>
    {%- elsif section.settings.text != blank -%}
      <p class="hero__title reveal">{{ section.settings.text | escape }}</p>
    {%- endif -%}
    <p class="hero__meta reveal">{{ 'password.coming_soon' | t }}</p>

    <div class="password__signup reveal">
      {% render 'newsletter-form', id: section.id %}
    </div>

    {%- liquid
      assign has_password_error = false
    -%}
    {%- capture password_form -%}
      {%- form 'storefront_password', class: 'password__form' -%}
        {%- if form.errors -%}
          {%- assign has_password_error = true -%}
          <p class="newsletter__msg newsletter__msg--error" role="alert">{{ 'password.wrong' | t }}</p>
        {%- endif -%}
        <label class="field-line" for="store-password">
          <span>{{ 'password.password' | t }}</span>
          <span class="field-line__row">
            <input id="store-password" type="password" name="password" autocomplete="current-password" required>
            <button type="submit" class="field-line__submit">{{ 'password.enter' | t }}{% render 'icon', name: 'arrow' %}</button>
          </span>
        </label>
      {%- endform -%}
    {%- endcapture -%}

    <div class="password__foot reveal">
      {%- if settings.instagram_url != blank -%}
        <a href="{{ settings.instagram_url }}" target="_blank" rel="noopener" class="password__link">
          {{- settings.instagram_url | split: '/' | last | prepend: '@' -}}
        </a>
      {%- endif -%}
      <details class="password__enter"{% if has_password_error %} open{% endif %}>
        <summary class="password__link">{{ 'password.enter_store' | t }}</summary>
        {{ password_form }}
        <p class="newsletter__fine">{{ 'password.owner' | t }} <a href="/admin" class="password__admin">{{ 'password.login' | t }}</a></p>
      </details>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Password page",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "WRLDWIDE"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "info": "Used when the password page message in Preferences is empty.",
      "default": "The first drop is on its way."
    }
  ]
}
{% endschema %}
