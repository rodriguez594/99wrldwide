<section class="hero hero--stripes password">
  <div class="hero__content">
    <img class="hero__mark reveal" src="{{ 'mark.png' | asset_url }}" alt="99" width="959" height="882" fetchpriority="high">
    <h1 class="hero__word reveal">{{ section.settings.heading | escape }}</h1>
    <p class="hero__tag reveal">{{ 'password.coming_soon' | t }}</p>

    {%- if shop.password_message != blank -%}
      <p class="lead reveal">{{ shop.password_message }}</p>
    {%- elsif section.settings.text != blank -%}
      <p class="lead reveal">{{ section.settings.text | escape }}</p>
    {%- endif -%}

    <div class="password__signup reveal">
      {% render 'newsletter-form', id: section.id %}
    </div>

    {%- if settings.instagram_url != blank -%}
      <a href="{{ settings.instagram_url }}" target="_blank" rel="noopener" class="password__social">
        {%- render 'icon', name: 'instagram' -%}
        <span>{{ settings.instagram_url | split: '/' | last | prepend: '@' }}</span>
      </a>
    {%- endif -%}

    {%- liquid
      assign has_password_error = false
    -%}
    {%- capture password_form -%}
      {%- form 'storefront_password', class: 'password__form' -%}
        {%- if form.errors -%}
          {%- assign has_password_error = true -%}
          <p class="newsletter__msg newsletter__msg--error" role="alert">{{ 'password.wrong' | t }}</p>
        {%- endif -%}
        <div class="newsletter__row">
          <label for="store-password" class="visually-hidden">{{ 'password.password' | t }}</label>
          <input id="store-password" class="input" type="password" name="password" autocomplete="current-password" placeholder="{{ 'password.password' | t }}" required>
          <button type="submit" class="btn">{{ 'password.enter' | t }}</button>
        </div>
      {%- endform -%}
    {%- endcapture -%}
    <details class="password__enter"{% if has_password_error %} open{% endif %}>
      <summary>{{ 'password.enter_store' | t }}</summary>
      {{ password_form }}
      <p class="newsletter__fine">{{ 'password.owner' | t }} <a href="/admin" class="link-underline">{{ 'password.login' | t }}</a></p>
    </details>
  </div>
</section>

{% schema %}
{
  "name": "Password page",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "WRLDWIDE"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "info": "Used when the password page message in Preferences is empty.",
      "default": "The first drop is on its way. Sign up to hear first."
    }
  ]
}
{% endschema %}
