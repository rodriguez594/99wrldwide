<header class="nav" data-header>
  <a href="{{ routes.root_url }}" class="nav__brand" aria-label="{{ shop.name }}">
    {%- if section.settings.logo != blank -%}
      {{ section.settings.logo | image_url: width: 120 | image_tag: alt: '', loading: 'eager' }}
    {%- else -%}
      <img src="{{ 'mark-160.png' | asset_url }}" alt="" width="44" height="40">
    {%- endif -%}
    {%- if section.settings.wordmark != blank -%}
      <span>{{ section.settings.wordmark | escape }}</span>
    {%- endif -%}
  </a>

  <nav class="nav__links" id="nav-menu" aria-label="{{ 'general.main_nav' | t }}">
    {%- for link in section.settings.menu.links -%}
      <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
    {%- endfor -%}
    <a href="{{ routes.search_url }}" class="nav__extra">{{ 'general.search' | t }}</a>
    {%- if shop.customer_accounts_enabled -%}
      <a href="{{ routes.account_url }}" class="nav__extra">{{ 'general.account' | t }}</a>
    {%- endif -%}
  </nav>

  <div class="nav__end">
    <a href="{{ routes.search_url }}" class="nav__text nav__search">{{ 'general.search' | t }}</a>
    {% render 'localization', id: 'header' %}
    <a href="{{ routes.cart_url }}" class="nav__text nav__bag" aria-label="{{ 'general.cart_count' | t: count: cart.item_count }}">
      {{- 'general.bag' | t }} <span class="nav__count">({{ cart.item_count }})</span>
    </a>
    <button class="nav__toggle" type="button" aria-label="{{ 'general.menu' | t }}" aria-expanded="false" aria-controls="nav-menu" data-nav-toggle>
      <span></span><span></span>
    </button>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "class": "section-header",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo mark",
      "info": "Leave empty to use the white 99 mark."
    },
    {
      "type": "text",
      "id": "wordmark",
      "label": "Word next to the mark",
      "default": "WRLDWIDE"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
