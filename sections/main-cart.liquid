<section class="section section--page cart">
  <div class="page-head">
    <h1 class="display">{{ 'cart.title' | t }}</h1>
  </div>

  {%- if cart.item_count > 0 -%}
    <form action="{{ routes.cart_url }}" method="post" id="cart" class="cart__form" novalidate>
      <ul class="cart__items">
        {%- for item in cart.items -%}
          <li class="cart-item">
            <a href="{{ item.url }}" class="cart-item__media" tabindex="-1" aria-hidden="true">
              {%- if item.image -%}
                {{ item.image | image_url: width: 300 | image_tag: loading: 'lazy', alt: '', widths: '150, 300' }}
              {%- else -%}
                {% render 'jersey-placeholder' %}
              {%- endif -%}
            </a>

            <div class="cart-item__info">
              <a href="{{ item.url }}" class="cart-item__title">{{ item.product.title | escape }}</a>
              {%- unless item.product.has_only_default_variant -%}
                <p class="cart-item__meta">
                  {%- for option in item.options_with_values -%}
                    {{ option.name | escape }}: {{ option.value | escape }}{% unless forloop.last %} · {% endunless %}
                  {%- endfor -%}
                </p>
              {%- endunless -%}
              {%- for property in item.properties -%}
                {%- assign first_char = property.first | slice: 0 -%}
                {%- if property.last != blank and first_char != '_' -%}
                  <p class="cart-item__meta">{{ property.first | escape }}: {{ property.last | escape }}</p>
                {%- endif -%}
              {%- endfor -%}
              {%- for discount in item.line_level_discount_allocations -%}
                <p class="cart-item__meta">{{ discount.discount_application.title | escape }} (-{{ discount.amount | money }})</p>
              {%- endfor -%}
              <p class="cart-item__price">{{ item.final_price | money }}</p>

              <div class="cart-item__actions">
                <label class="visually-hidden" for="updates-{{ item.key }}">{{ 'cart.quantity_for' | t: title: item.product.title }}</label>
                <input
                  class="input qty__input"
                  type="number"
                  id="updates-{{ item.key }}"
                  name="updates[]"
                  value="{{ item.quantity }}"
                  min="0"
                  inputmode="numeric"
                  data-auto-submit
                >
                <a href="{{ item.url_to_remove }}" class="link-underline">{{ 'cart.remove' | t }}</a>
              </div>
            </div>

            <p class="cart-item__total">{{ item.final_line_price | money }}</p>
          </li>
        {%- endfor -%}
      </ul>

      <div class="cart__foot">
        {%- if section.settings.show_note -%}
          <div class="cart__note">
            <label for="cart-note" class="label label--tight">{{ 'cart.note' | t }}</label>
            <textarea id="cart-note" name="note" class="input" rows="3">{{ cart.note }}</textarea>
          </div>
        {%- endif -%}

        <div class="cart__summary">
          {%- for discount in cart.cart_level_discount_applications -%}
            <p class="cart__row">
              <span>{{ discount.title | escape }}</span>
              <span>-{{ discount.total_allocated_amount | money }}</span>
            </p>
          {%- endfor -%}
          <p class="cart__row cart__row--total">
            <span>{{ 'cart.subtotal' | t }}</span>
            <span>{{ cart.total_price | money_with_currency }}</span>
          </p>
          <p class="cart__fine">
            {%- if cart.taxes_included -%}
              {{ 'cart.taxes_included' | t }}
            {%- else -%}
              {{ 'cart.taxes_at_checkout' | t }}
            {%- endif %}
            {{ 'cart.shipping_at_checkout' | t -}}
          </p>
          <noscript>
            <button type="submit" name="update" class="btn btn--block">{{ 'cart.update' | t }}</button>
          </noscript>
          <button type="submit" name="checkout" class="btn btn--solid btn--block">
            {{- 'cart.checkout' | t -}}
          </button>
          {%- if additional_checkout_buttons and section.settings.show_express -%}
            <div class="cart__express">{{ content_for_additional_checkout_buttons }}</div>
          {%- endif -%}
        </div>
      </div>
    </form>
  {%- else -%}
    <div class="empty">
      <p>{{ 'cart.empty' | t }}</p>
      <a href="{{ routes.all_products_collection_url }}" class="btn btn--solid">{{ 'cart.continue' | t }}</a>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Cart",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_note",
      "label": "Let customers add an order note",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_express",
      "label": "Show express checkout buttons",
      "default": true
    }
  ]
}
{% endschema %}
