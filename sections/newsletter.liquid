<section class="section signup" id="signup">
  {%- if section.settings.label != blank -%}
    <p class="label">{{ section.settings.label | escape }}</p>
  {%- endif -%}
  {%- if section.settings.heading != blank -%}
    <h2 class="signup__title reveal">{{ section.settings.heading | escape }}</h2>
  {%- endif -%}
  <div class="signup__grid reveal">
    {%- if section.settings.text != blank -%}
      <div class="signup__text rte">{{ section.settings.text }}</div>
    {%- endif -%}
    {% render 'newsletter-form', id: section.id %}
  </div>
</section>

{% schema %}
{
  "name": "Email sign-up",
  "settings": [
    { "type": "text", "id": "label", "label": "Small label", "default": "Newsletter" },
    { "type": "text", "id": "heading", "label": "Heading (large italic)", "default": "First in line" },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Get the release date and early access to every drop.</p>"
    }
  ],
  "presets": [
    { "name": "Email sign-up" }
  ]
}
{% endschema %}
