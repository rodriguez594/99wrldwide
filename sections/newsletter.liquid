<section class="section section--center">
  {%- if section.settings.label != blank -%}
    <p class="label">{{ section.settings.label | escape }}</p>
  {%- endif -%}
  {%- if section.settings.heading != blank -%}
    <h2 class="display reveal">{{ section.settings.heading | escape }}</h2>
  {%- endif -%}
  {%- if section.settings.text != blank -%}
    <div class="rte lead reveal">{{ section.settings.text }}</div>
  {%- endif -%}
  <div class="reveal">
    {% render 'newsletter-form', id: section.id %}
  </div>
</section>

{% schema %}
{
  "name": "Email sign-up",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Small label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Be first in line"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Get the release date and early access to every drop.</p>"
    }
  ],
  "presets": [
    {
      "name": "Email sign-up"
    }
  ]
}
{% endschema %}
