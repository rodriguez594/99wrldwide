<footer class="footer">
  <div class="footer__top">
    {%- if section.settings.menu.links.size > 0 -%}
      <nav class="footer__menu" aria-label="{{ 'general.footer_nav' | t }}">
        <ul>
          {%- for link in section.settings.menu.links -%}
            <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
          {%- endfor -%}
        </ul>
      </nav>
    {%- endif -%}

    {%- if settings.instagram_url != blank -%}
      <a href="{{ settings.instagram_url }}" target="_blank" rel="noopener" class="footer__social">
        {%- render 'icon', name: 'instagram' -%}
        <span>{{ settings.instagram_url | split: '/' | last | prepend: '@' }}</span>
      </a>
    {%- endif -%}
  </div>

  <div class="footer__bottom">
    <img src="{{ 'mark-160.png' | asset_url }}" alt="" width="33" height="30" loading="lazy">
    <p>
      &copy; {{ 'now' | date: '%Y' }} {{ shop.name | escape -}}
      {%- if section.settings.tagline != blank %}, {{ section.settings.tagline | escape }}{% endif %}
    </p>
    {%- if section.blocks.size > 0 -%}
      <nav class="footer__family" aria-label="99">
        {%- for block in section.blocks -%}
          <a href="{{ block.settings.url }}" target="_blank" rel="noopener" {{ block.shopify_attributes }}>
            {{- block.settings.label | escape -}}
          </a>
        {%- endfor -%}
      </nav>
    {%- endif -%}
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "section-footer",
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "footer",
      "info": "Link your shipping, returns, privacy and terms pages here."
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Text after the copyright",
      "default": "part of 99"
    }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Sister brand link",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "99MGMT" },
        { "type": "url", "id": "url", "label": "Link" }
      ]
    }
  ]
}
{% endschema %}
