<section class="section section--page">
  <div class="page-head">
    <h1 class="display">{{ 'search.title' | t }}</h1>
  </div>

  <form action="{{ routes.search_url }}" method="get" role="search" class="searchbar">
    <label for="search-q" class="visually-hidden">{{ 'search.placeholder' | t }}</label>
    <input
      id="search-q"
      class="input"
      type="search"
      name="q"
      value="{{ search.terms | escape }}"
      placeholder="{{ 'search.placeholder' | t }}"
      autocomplete="off"
    >
    <input type="hidden" name="options[prefix]" value="last">
    <button type="submit" class="btn btn--solid">{{ 'general.search' | t }}</button>
  </form>

  {%- if search.performed -%}
    {%- paginate search.results by 24 -%}
      <p class="toolbar__count">{{ 'search.results_for' | t: count: search.results_count, terms: search.terms }}</p>
      {%- if search.results_count > 0 -%}
        <div class="grid grid--3">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              {% render 'product-card', product: item %}
            {%- else -%}
              <article class="card card--text reveal">
                <a href="{{ item.url }}" class="card__link">
                  <p class="label label--tight">{{ item.object_type | capitalize }}</p>
                  <h2 class="card__title">{{ item.title | escape }}</h2>
                  <p class="card__sub">{{ item.content | strip_html | truncatewords: 24 }}</p>
                </a>
              </article>
            {%- endif -%}
          {%- endfor -%}
        </div>
        {% render 'pagination', paginate: paginate %}
      {%- else -%}
        <p class="empty">{{ 'search.no_results' | t }}</p>
      {%- endif -%}
    {%- endpaginate -%}
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Search",
  "settings": []
}
{% endschema %}
