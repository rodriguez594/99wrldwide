{%- paginate collection.products by section.settings.per_page -%}
  <section class="section section--page">
    <div class="page-head">
      <h1 class="display">{{ collection.title | escape }}</h1>
      {%- if collection.description != blank -%}
        <div class="rte lead">{{ collection.description }}</div>
      {%- endif -%}
    </div>

    {%- if collection.products_count > 1 -%}
      <form class="toolbar" method="get">
        <p class="toolbar__count">{{ 'collections.product_count' | t: count: collection.products_count }}</p>
        <label class="toolbar__sort">
          <span class="visually-hidden">{{ 'collections.sort_by' | t }}</span>
          <select name="sort_by" class="select" data-auto-submit>
            {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
            {%- for option in collection.sort_options -%}
              <option value="{{ option.value | escape }}"{% if option.value == sort_by %} selected{% endif %}>
                {{- option.name | escape -}}
              </option>
            {%- endfor -%}
          </select>
        </label>
        <noscript><button type="submit" class="btn">{{ 'collections.sort_by' | t }}</button></noscript>
      </form>
    {%- endif -%}

    {%- if collection.products.size > 0 -%}
      <div class="grid grid--{{ section.settings.columns }}">
        {%- for product in collection.products -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="empty">{{ 'collections.empty' | t }}</p>
    {%- endif -%}

    {% render 'pagination', paginate: paginate %}
  </section>
{%- endpaginate -%}

{% schema %}
{
  "name": "Collection",
  "settings": [
    {
      "type": "range",
      "id": "per_page",
      "label": "Products per page",
      "min": 4,
      "max": 48,
      "step": 4,
      "default": 24
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns on desktop",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "3"
    }
  ]
}
{% endschema %}
