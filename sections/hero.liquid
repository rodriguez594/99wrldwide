<section class="hero{% if section.settings.image != blank %} hero--image{% endif %}">
  {%- if section.settings.image != blank -%}
    <div class="hero__bg">
      {{
        section.settings.image
        | image_url: width: 2400
        | image_tag:
          loading: 'eager',
          fetchpriority: 'high',
          widths: '750, 1100, 1500, 1800, 2400',
          sizes: '100vw',
          alt: section.settings.image.alt
      }}
    </div>
  {%- endif -%}

  <div class="hero__content">
    <img class="hero__mark reveal" src="{{ 'mark.png' | asset_url }}" alt="99" width="959" height="882" fetchpriority="high">
    {%- if section.settings.heading != blank -%}
      <h1 class="hero__word reveal">{{ section.settings.heading | escape }}</h1>
    {%- endif -%}
    {%- if section.settings.tagline != blank -%}
      <p class="hero__title reveal">{{ section.settings.tagline | escape }}</p>
    {%- endif -%}
    {%- if section.settings.meta != blank -%}
      <p class="hero__meta reveal">{{ section.settings.meta | escape }}</p>
    {%- endif -%}
    {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
      <a href="{{ section.settings.button_link }}" class="btn hero__btn reveal">{{ section.settings.button_label | escape }}</a>
    {%- endif -%}
  </div>

  {%- if section.settings.scroll_label != blank -%}
    <a href="#{{ section.settings.scroll_target | default: 'main' }}" class="hero__scroll">{{ section.settings.scroll_label | escape }}</a>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Hero",
  "class": "section-hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image",
      "info": "Optional. Darkened so the text stays readable."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Wordmark",
      "default": "WRLDWIDE"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline (italic)",
      "default": "Luxury streetwear with a 1990s football edge."
    },
    {
      "type": "text",
      "id": "meta",
      "label": "Small text",
      "default": "Copenhagen"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "scroll_label",
      "label": "Scroll hint",
      "default": "Scroll"
    },
    {
      "type": "text",
      "id": "scroll_target",
      "label": "Scroll hint target",
      "info": "The id of the section to scroll to, e.g. drop.",
      "default": "drop"
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
