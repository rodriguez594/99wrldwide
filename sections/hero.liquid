<section class="hero{% if section.settings.image != blank %} hero--image{% elsif section.settings.pinstripes %} hero--stripes{% endif %}">
  {%- if section.settings.image != blank -%}
    <div class="hero__bg">
      {{
        section.settings.image
        | image_url: width: 2400
        | image_tag:
          loading: 'eager',
          fetchpriority: 'high',
          widths: '750, 1100, 1500, 1800, 2400',
          sizes: '100vw',
          alt: section.settings.image.alt
      }}
    </div>
  {%- endif -%}

  <div class="hero__content">
    {%- if section.settings.show_mark -%}
      <img class="hero__mark reveal" src="{{ 'mark.png' | asset_url }}" alt="99" width="959" height="882" fetchpriority="high">
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h1 class="hero__word reveal">{{ section.settings.heading | escape }}</h1>
    {%- endif -%}
    {%- if section.settings.tag != blank -%}
      <p class="hero__tag reveal">{{ section.settings.tag | escape }}</p>
    {%- endif -%}
    {%- if section.settings.meta != blank -%}
      <p class="hero__meta reveal">{{ section.settings.meta | escape }}</p>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="btn btn--solid hero__btn reveal">
        {{- section.settings.button_label | escape -}}
      </a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "class": "section-hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image",
      "info": "Optional. Darkened so the text stays readable."
    },
    {
      "type": "checkbox",
      "id": "pinstripes",
      "label": "Jersey pinstripes (when there is no image)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_mark",
      "label": "Show the 99 mark",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "WRLDWIDE"
    },
    {
      "type": "text",
      "id": "tag",
      "label": "Boxed tag",
      "default": "First drop"
    },
    {
      "type": "text",
      "id": "meta",
      "label": "Small text",
      "default": "Copenhagen"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
