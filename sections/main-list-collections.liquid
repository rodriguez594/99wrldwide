<section class="section section--page">
  <div class="page-head">
    <h1 class="display">{{ section.settings.heading | default: page_title | escape }}</h1>
  </div>

  {%- paginate collections by 24 -%}
    <div class="grid grid--3">
      {%- for collection in collections -%}
        <article class="card reveal">
          <a href="{{ collection.url }}" class="card__link">
            <div class="card__media">
              {%- if collection.featured_image -%}
                {{
                  collection.featured_image
                  | image_url: width: 900
                  | image_tag:
                    loading: 'lazy',
                    widths: '300, 450, 600, 900',
                    sizes: '(min-width: 990px) 33vw, (min-width: 600px) 50vw, 100vw',
                    class: 'card__img'
                }}
              {%- else -%}
                {% render 'jersey-placeholder' %}
              {%- endif -%}
            </div>
            <div class="card__info">
              <h2 class="card__title">{{ collection.title | escape }}</h2>
              <span class="card__sub">{{ 'collections.product_count' | t: count: collection.products_count }}</span>
            </div>
          </a>
        </article>
      {%- endfor -%}
    </div>
    {% render 'pagination', paginate: paginate %}
  {%- endpaginate -%}
</section>

{% schema %}
{
  "name": "Collections list",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Collections"
    }
  ]
}
{% endschema %}
