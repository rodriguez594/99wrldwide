{%- comment -%}
  Usage: {% render 'pagination', paginate: paginate %}
{%- endcomment -%}
{%- if paginate.pages > 1 -%}
  <nav class="pagination" aria-label="{{ 'general.pagination' | t }}">
    {%- if paginate.previous -%}
      <a href="{{ paginate.previous.url }}" class="pagination__link">{{ 'general.previous' | t }}</a>
    {%- endif -%}
    {%- for part in paginate.parts -%}
      {%- if part.is_link -%}
        <a href="{{ part.url }}" class="pagination__link">{{ part.title }}</a>
      {%- elsif part.title == paginate.current_page -%}
        <span class="pagination__link is-current" aria-current="page">{{ part.title }}</span>
      {%- else -%}
        <span class="pagination__link">{{ part.title }}</span>
      {%- endif -%}
    {%- endfor -%}
    {%- if paginate.next -%}
      <a href="{{ paginate.next.url }}" class="pagination__link">{{ 'general.next' | t }}</a>
    {%- endif -%}
  </nav>
{%- endif -%}
