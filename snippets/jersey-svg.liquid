{%- comment -%}
  Line drawing of The 99 Jersey, used until product photos exist.
  Usage: {% render 'jersey-svg', side: 'front', id: section.id %}   (side: 'front' or 'back')
{%- endcomment -%}
{%- liquid
  assign uid = 'j-' | append: id | append: '-' | append: side
-%}
<svg class="jersey jersey--{{ side }}" viewBox="0 0 400 440" role="img" aria-label="The 99 Jersey, {{ side }}">
  <defs>
    <pattern id="{{ uid }}-stripes" width="13" height="10" patternUnits="userSpaceOnUse">
      <rect x="12" width="1" height="10" fill="rgba(244,242,238,0.16)"/>
    </pattern>
    <clipPath id="{{ uid }}-body">
      <path d="M152 28 L98 42 L22 104 L50 182 L100 160 L104 418 Q200 428 296 418 L300 160 L350 182 L378 104 L302 42 L248 28 Q200 58 152 28 Z"/>
    </clipPath>
  </defs>

  {%- comment -%} Body {%- endcomment -%}
  <path d="M152 28 L98 42 L22 104 L50 182 L100 160 L104 418 Q200 428 296 418 L300 160 L350 182 L378 104 L302 42 L248 28 Q200 58 152 28 Z" fill="#0b0b0b"/>
  <rect width="400" height="440" fill="url(#{{ uid }}-stripes)" clip-path="url(#{{ uid }}-body)"/>

  {%- comment -%} Three stripes down each sleeve {%- endcomment -%}
  <g stroke="#f4f2ee" stroke-width="3.2" stroke-linecap="butt" clip-path="url(#{{ uid }}-body)">
    <path d="M118 44 L36 112"/><path d="M124 52 L41 122"/><path d="M130 60 L46 132"/>
    <path d="M282 44 L364 112"/><path d="M276 52 L359 122"/><path d="M270 60 L354 132"/>
  </g>

  {%- comment -%} Cuffs and hem {%- endcomment -%}
  <g fill="none" stroke="rgba(244,242,238,0.55)" stroke-width="1">
    <path d="M43 162 L94 140"/><path d="M357 162 L306 140"/>
    <path d="M104 406 Q200 416 296 406"/>
  </g>

  {%- if side == 'front' -%}
    {%- comment -%} Polo collar, placket, three white buttons {%- endcomment -%}
    <path d="M152 28 Q200 46 248 28" fill="none" stroke="#f4f2ee" stroke-width="1.4"/>
    <rect x="191" y="62" width="18" height="82" fill="#000" stroke="rgba(244,242,238,0.55)" stroke-width="1"/>
    <path d="M146 30 Q172 50 199 64 L176 92 Q156 66 136 40 Z" fill="#000" stroke="#f4f2ee" stroke-width="1.4" stroke-linejoin="round"/>
    <path d="M254 30 Q228 50 201 64 L224 92 Q244 66 264 40 Z" fill="#000" stroke="#f4f2ee" stroke-width="1.4" stroke-linejoin="round"/>
    <g fill="#f4f2ee">
      <circle cx="200" cy="84" r="3.6"/><circle cx="200" cy="104" r="3.6"/><circle cx="200" cy="124" r="3.6"/>
    </g>

    {%- comment -%} The 99 crest {%- endcomment -%}
    <g transform="translate(258 132)">
      <circle r="27" fill="#000" stroke="#f4f2ee" stroke-width="1.4"/>
      <circle r="18.5" fill="none" stroke="#f4f2ee" stroke-width="0.6"/>
      <path id="{{ uid }}-ring" d="M -22.5 0 A 22.5 22.5 0 1 1 22.5 0 A 22.5 22.5 0 1 1 -22.5 0" fill="none"/>
      <text font-family="Inter, sans-serif" font-size="5.6" font-weight="500" letter-spacing="2.1" fill="#f4f2ee">
        <textPath href="#{{ uid }}-ring" startOffset="2%">WORLDWIDE · WORLDWIDE ·</textPath>
      </text>
      <text y="8.5" text-anchor="middle" font-family="'Bodoni Moda', serif" font-size="24" fill="#f4f2ee">99</text>
    </g>
  {%- else -%}
    {%- comment -%} Back collar band with the small script {%- endcomment -%}
    <path d="M152 28 Q200 58 248 28 L252 38 Q200 70 148 38 Z" fill="#000" stroke="#f4f2ee" stroke-width="1.4" stroke-linejoin="round"/>
    <text x="200" y="52" text-anchor="middle" font-family="'Bodoni Moda', serif" font-style="italic" font-size="8.5" fill="#f4f2ee">worldwide</text>

    {%- comment -%} NINETY over a large 99 {%- endcomment -%}
    <text x="200" y="128" text-anchor="middle" font-family="Inter, sans-serif" font-weight="500" font-size="21" letter-spacing="7" fill="#f4f2ee">NINETY</text>
    <text x="200" y="300" text-anchor="middle" font-family="'Bodoni Moda', serif" font-size="172" fill="#f4f2ee">99</text>
  {%- endif -%}

  {%- comment -%} Outline on top {%- endcomment -%}
  <path d="M152 28 L98 42 L22 104 L50 182 L100 160 L104 418 Q200 428 296 418 L300 160 L350 182 L378 104 L302 42 L248 28" fill="none" stroke="rgba(244,242,238,0.7)" stroke-width="1.2" stroke-linejoin="round"/>
</svg>
