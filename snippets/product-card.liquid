{%- comment -%}
  Usage: {% render 'product-card', product: product %}
  Shows the second image on hover when the product has one.
{%- endcomment -%}
<article class="card reveal">
  <a href="{{ product.url }}" class="card__link">
    <div class="card__media{% if product.media.size > 1 %} card__media--swap{% endif %}">
      {%- if product.featured_media -%}
        {{
          product.featured_media
          | image_url: width: 900
          | image_tag:
            loading: 'lazy',
            widths: '300, 450, 600, 900',
            sizes: '(min-width: 990px) 33vw, (min-width: 600px) 50vw, 100vw',
            alt: product.featured_media.alt,
            class: 'card__img'
        }}
        {%- if product.media.size > 1 and product.media[1].media_type == 'image' -%}
          {{
            product.media[1]
            | image_url: width: 900
            | image_tag:
              loading: 'lazy',
              widths: '300, 450, 600, 900',
              sizes: '(min-width: 990px) 33vw, (min-width: 600px) 50vw, 100vw',
              alt: '',
              class: 'card__img card__img--alt'
          }}
        {%- endif -%}
      {%- else -%}
        {% render 'jersey-placeholder', id: product.id %}
      {%- endif -%}
    </div>
    <div class="card__info">
      <h3 class="card__title">{{ product.title | escape }}</h3>
      <span class="card__price">{% render 'price', product: product %}</span>
    </div>
  </a>
</article>
