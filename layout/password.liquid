<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="no-js">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#000000">
    <title>{{ shop.name }} | {{ 'password.coming_soon' | t }}</title>
    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {% render 'meta-tags' %}
    {% render 'head-assets' %}

    {{ content_for_header }}
  </head>

  <body class="template-password">
    <main id="main" class="main main--flush" role="main">
      {{ content_for_layout }}
    </main>
  </body>
</html>
