{% layout none %}
{%- liquid
  assign initial_value = gift_card.initial_value | money
  assign expires_on = gift_card.expires_on | date: '%d.%m.%Y'
-%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex">
    <title>{{ 'gift_card.title' | t: value: initial_value | strip_html }} | {{ shop.name }}</title>
    {% render 'head-assets' %}
    {{ content_for_header }}
  </head>
  <body class="template-gift-card">
    <main class="section section--page section--center section--narrow giftcard">
      <img src="{{ 'mark.png' | asset_url }}" alt="{{ shop.name }}" width="959" height="882" class="giftcard__mark">
      <h1 class="display">{{ 'gift_card.heading' | t }}</h1>
      <p class="giftcard__balance">{{ gift_card.balance | money }}</p>
      {%- if gift_card.enabled == false or gift_card.expired -%}
        <p class="note">{{ 'gift_card.unavailable' | t }}</p>
      {%- elsif gift_card.expires_on -%}
        <p class="lead">{{ 'gift_card.expires' | t: date: expires_on }}</p>
      {%- endif -%}
      <p class="giftcard__code" aria-label="{{ 'gift_card.code' | t }}">{{ gift_card.code | format_code }}</p>
      <div class="giftcard__actions">
        <a href="{{ shop.url }}" class="btn btn--solid">{{ 'gift_card.shop' | t }}</a>
        {%- if gift_card.pass_url -%}
          <a href="{{ gift_card.pass_url }}" class="btn">{{ 'gift_card.wallet' | t }}</a>
        {%- endif -%}
      </div>
    </main>
  </body>
</html>
